# ─────────────────────────────────────────────────────────────────────────────
# NowAI Web Agent Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────

# URL of your standalone NowAIKit MCP Server deployed on Render (Free Tier)
# e.g., https://nowaikit-mcp-xxxx.onrender.com (without trailing slash)
NOWAI_MCP_URL=https://your-nowaikit-mcp.onrender.com

# Bearer API Key configured on Render under NOWAIKIT_API_KEY
NOWAI_MCP_API_KEY=your-mcp-bearer-token

# Google Gemini API Key (Gemini 3.5 Flash-Lite / 2.5 Flash)
GEMINI_API_KEY=your-google-gemini-api-key

# Optional: Override Gemini Model (Default: gemini-2.5-flash or gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-2.5-flash

# Access Gate PIN (Default: 1234)
NOWAI_PIN=1234

# ServiceNow Instance Base URL (Default: https://dev312295.service-now.com)
SERVICENOW_INSTANCE_URL=https://dev312295.service-now.com
